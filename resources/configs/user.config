#cloud-config

users:
  - default
  - name: ubuntu
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: sudo
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: "12345678Aa"

ssh_pwauth: false

chpasswd:
  expire: false

write_files:
  - path: /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg
    permissions: "0644"
    content: |
      network: {config: disabled}

  - path: /etc/netplan/01-bastion.yaml
    permissions: "0600"
    content: |
      network:
        version: 2
        ethernets:
          ens3:
            dhcp4: true
          ens4:
            dhcp4: true
            dhcp4-overrides:
              use-routes: false
              use-dns: false

runcmd:
  - rm -f /etc/netplan/50-cloud-init.yaml /etc/netplan/99-bastion.yaml
  - netplan generate
  - netplan apply