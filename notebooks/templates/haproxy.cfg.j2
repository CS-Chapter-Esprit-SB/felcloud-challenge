global
    log /dev/log local0
    log /dev/log local1 notice
    user haproxy
    group haproxy
    daemon
    maxconn 4096
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5s
    timeout client 50s
    timeout server 50s
frontend http-in
    bind *:80
    mode http
    redirect scheme https code 301

frontend https-in
    bind *:443 ssl crt /etc/haproxy/certs/{{ domain }}.pem
    mode http
    option forwardfor

    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Port 443
    http-request set-header X-Forwarded-Host %[req.hdr(Host)]
    
    use_backend %[req.hdr(host),lower,field(1,:),map(/etc/haproxy/hosts.map,be_default)]

{% for c in haproxy_clients %}
backend be_{{ c.name }}
    mode http
    option forwardfor
    option httpchk GET /health
    http-check expect status 200
    server {{ c.name }} {{ c.address }}:{{ c.port }} check inter 3s fall 3 rise 2

{% endfor %}