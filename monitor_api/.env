DATABASE_URL=postgresql+psycopg://monitoring:test_123@127.0.0.1:5432/sandbox_manager

OS_CLOUD=default

HAPROXY_LOG_FILE=/var/log/remote-haproxy.log

# Protect infrastructure by name and, preferably, UUID.
INFRASTRUCTURE_INSTANCES=haproxy-master,haproxy-backup,squid-master,squid-backup,client-vm
INFRASTRUCTURE_IDS=

# Map HAProxy server names to their OpenStack VM IPs.
# Replace these example addresses with your real backend addresses.
HAPROXY_TARGET_MAP={"sandbox-1":"10.0.1.11","sandbox-2":"10.0.1.12"}

# Consumer polling interval.
CONSUMER_INTERVAL_SECONDS=15

# Initial policy: record activity and identify idle candidates only.
SANDBOX_IDLE_TIMEOUT_MINUTES=30
SANDBOX_AUTO_STOP_ENABLED=false